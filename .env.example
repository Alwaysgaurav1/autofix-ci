# ========================================================
# AutoFix CI - Configuration
# Nebius x NVIDIA Global AI Hackathon
# ========================================================

# Nebius Token Factory Credentials
# Get your API key from https://tokenfactory.nebius.com/
NEBIUS_API_KEY="your_nebius_api_key_here"
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1/"

# NVIDIA Models on Nebius Token Factory
# Supported options:
# - nvidia/Llama-3.1-Nemotron-70B-Instruct
# - nebius/nvidia/nemotron-3-super-120b-a12b
# - nebius/nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL="nvidia/Llama-3.1-Nemotron-70B-Instruct"

# GitHub Integration (Optional - for opening real Pull Requests)
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# Agent Loop Settings
AUTOFIX_MAX_ITERATIONS=3
AUTOFIX_TIMEOUT_SECONDS=60
AUTOFIX_MOCK_FALLBACK=true

# Server Settings
API_HOST="0.0.0.0"
API_PORT=8000
